{
  "info": {
    "name": "Trading Journal API",
    "description": "Stock Portfolio Tracker endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"trader1\",\n  \"email\": \"trader1@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {"raw": "http://localhost:8000/auth/register"}
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "username", "value": "trader1"},
                {"key": "password", "value": "password123"}
              ]
            },
            "url": {"raw": "http://localhost:8000/auth/login"}
          }
        }
      ]
    },
    {
      "name": "Trades",
      "item": [
        {
          "name": "Create Trade",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"BBCA\",\n  \"trade_type\": \"BUY\",\n  \"strategy\": \"Breakout\",\n  \"entry_date\": \"2024-01-15T10:30:00Z\",\n  \"entry_price\": 8500,\n  \"exit_date\": \"2024-01-16T15:45:00Z\",\n  \"exit_price\": 8750,\n  \"lot_quantity\": 10,\n  \"stop_loss\": 8300,\n  \"target_price\": 8800,\n  \"notes\": \"Clean breakout\"\n}"
            },
            "url": {"raw": "http://localhost:8000/trades/"}
          }
        },
        {
          "name": "Get All Trades",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {"raw": "http://localhost:8000/trades/"}
          }
        },
        {
          "name": "Get Trade by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {"raw": "http://localhost:8000/trades/1"}
          }
        },
        {
          "name": "Update Trade",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exit_price\": 8800,\n  \"notes\": \"Hit target price\"\n}"
            },
            "url": {"raw": "http://localhost:8000/trades/1"}
          }
        },
        {
          "name": "Delete Trade",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {"raw": "http://localhost:8000/trades/1"}
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {"raw": "http://localhost:8000/analytics/"}
          }
        }
      ]
    }
  ]
}
